.mono/
data_*/
mono_crash.*.json

# Plugin Godot AI: backup e stato degli aggiornamenti locali
addons/.godot_ai_update/

# Vecchio progetto Godot creato in odyssey/ (sostituito da quello nella root)
/odyssey/

